  "production_constraints": [
    "Redraw or extract individual components before use; the sheets include presentation lighting and are not atlases.",
    "Preserve generous transparent center regions for live content.",
    "Author scalable rectangular frames as 9-slice assets and validate slice offsets at multiple aspect ratios.",
    "Keep active cyan sparse so state changes remain legible.",
    "Keep labels, values, icons, and localization outside the raster art.",
    "Test selected, focused, disabled, locked, and controller-navigation states for contrast."
  ],
  "recommended_first_slice": {
    "name": "foundation panel and button kit",
    "deliverables": [
      "one large 9-slice panel",
      "one compact 9-slice panel",
      "one titlebar or divider",
      "one button atlas with idle, hover, pressed, selected, and disabled states"
    ]
