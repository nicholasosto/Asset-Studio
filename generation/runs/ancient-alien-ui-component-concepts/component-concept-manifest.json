{
  "family": "ancient-alien-ui-components",
  "status": "blockout",
  "resolution": [1024, 1024],
  "intended_target": "Roblox interface component production reference",
  "source_role": "concept sheets, not sliced or upload-ready UI assets",
  "style_contract": {
    "structural_body": "dense black obsidian ceramic",
    "edge_lip": "thin cool iridium or gunmetal",
    "seams": "recessed black pressure gasket",
    "active_signal": "sparse cyan-blue emissive channels",
    "idle_signal": "muted blue-grey",
    "disabled_signal": "desaturated near-black",
    "shape_language": [
      "monumental modular frames",
      "mechanical iris segmentation",
      "nested rails",
      "precision-machined alien mechanisms"
    ],
    "text_policy": "no baked text, numerals, glyphs, or runes; overlay live Roblox UI"
  },
  "sheets": [
    {
      "asset": "ancient-tech-ui-foundation-components-01_BLK.png",
      "role": "foundational chrome and controls",
      "components": [
        "large content frame",
        "compact content frame",
        "title and divider rails",
        "button state set",
        "tab set",
        "slider and progress rails",
        "corner caps",
        "toggle",
        "compact square control"
      ],
      "production_routes": [
        "ui/frames/panel-*",
        "ui/frames/titlebar-*",
        "ui/frames/divider-*",
        "ui/frames/corner-*",
        "ui/sprites/atlas-ancient-tech-controls-*"
      ]
    },
